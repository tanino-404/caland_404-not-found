{
  "schemaVersion": 1,
  "id": "fitness",
  "name": "フィットネス",
  "version": "1.0.0",
  "description": "トレーニングと体重を記録する。期間のトレーニング回数が目標に届くと、島からムキムキの腕が生えてダンベルを上げる。",
  "preinstalled": true,
  "islands": [
    "muscle"
  ],
  "fields": [
    {
      "key": "training",
      "type": "select",
      "label": "トレーニング",
      "options": [
        {
          "value": "bench",
          "label": "ベンチプレス"
        },
        {
          "value": "squat",
          "label": "スクワット"
        },
        {
          "value": "deadlift",
          "label": "デッドリフト"
        },
        {
          "value": "run",
          "label": "ランニング"
        },
        {
          "value": "core",
          "label": "体幹"
        }
      ],
      "required": true
    },
    {
      "key": "weight_kg",
      "type": "number",
      "label": "重さ",
      "unit": "kg",
      "min": 0
    },
    {
      "key": "reps",
      "type": "integer",
      "label": "回数",
      "unit": "回",
      "min": 1
    },
    {
      "key": "sets",
      "type": "integer",
      "label": "セット",
      "unit": "セット",
      "min": 1
    },
    {
      "key": "minutes",
      "type": "integer",
      "label": "時間",
      "unit": "分",
      "min": 1
    },
    {
      "key": "body_weight",
      "type": "number",
      "label": "体重",
      "unit": "kg",
      "min": 20,
      "max": 200
    },
    {
      "key": "memo",
      "type": "text",
      "label": "メモ"
    }
  ],
  "metrics": [
    {
      "key": "sessions",
      "label": "トレーニング",
      "agg": "count",
      "unit": "回"
    },
    {
      "key": "minutes",
      "label": "合計時間",
      "agg": "sum",
      "field": "minutes",
      "unit": "分"
    },
    {
      "key": "bench_max",
      "label": "ベンチプレス最高",
      "agg": "max",
      "field": "weight_kg",
      "unit": "kg",
      "where": {
        "field": "training",
        "values": [
          "bench"
        ]
      }
    },
    {
      "key": "body_weight",
      "label": "体重",
      "agg": "latest",
      "field": "body_weight",
      "unit": "kg"
    },
    {
      "key": "weight_change",
      "label": "体重の増減",
      "agg": "delta",
      "field": "body_weight",
      "unit": "kg",
      "op": "<="
    }
  ],
  "goal": {
    "metric": "sessions",
    "op": ">="
  },
