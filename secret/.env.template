# これを secret/.env にコピーして値を埋める（.env は git 管理外）
# Claude API（https://console.anthropic.com/ の API キー）
CLAUDE_API_KEY=
# 使うモデル。空なら claude-sonnet-5
CLAUDE_MODEL=
# YuMake 気象情報 API のキー
YUMAKE_API_KEY=
# LINE Messaging API（LINE Developers コンソールのチャネルアクセストークン（長期））
LINE_CHANNEL_ACCESS_TOKEN=
# 送信先。LINE Developers コンソールの「チャネル基本設定 > あなたのユーザーID」（U で始まる）
LINE_PUSH_TO=
